{
  "_doc": "Memória do repo som-agent-skill. key_prefix jev é histórico e permanece estável para preservar supersessão; pesquisa/contratos derivados da web mantêm origem untrusted.",
  "version": 1,
  "key_prefix": "jev",
  "path_prefix": "",
  "exclude": [],
  "rules": [
    {
      "name": "learnings",
      "include": ["LEARNINGS.md"],
      "mode": "markdown",
      "type": "episodic",
      "origin": "agent",
      "tags": "learnings,evolucao,historico"
    },
    {
      "name": "skill",
      "include": ["SKILL.md"],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "skill,contrato"
    },
    {
      "name": "pesquisas-web",
      "include": ["references/pesquisa*.md"],
      "mode": "markdown",
      "type": "semantic",
      "origin": "untrusted",
      "tags": "pesquisa,web,{stem}"
    },
    {
      "name": "contratos-web",
      "include": ["references/api.md", "references/multimodal.md"],
      "mode": "markdown",
      "type": "semantic",
      "origin": "untrusted",
      "tags": "contrato,web,{stem}"
    },
    {
      "name": "referencias",
      "include": ["references/**/*.md"],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "referencia,{stem}"
    },
    {
      "name": "readme",
      "include": ["README.md"],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,readme"
    }
  ],
  "graph": { "entities": [], "edges": [] }
}
